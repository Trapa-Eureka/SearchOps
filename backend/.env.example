# Copy to .env (git-ignored) and fill in real values. Placeholders only in this file.

# SerpApi (Stage 3). Never commit a real key.
SERPAPI_API_KEY=replace_me

# Natural-language planning (Stage 5) is optional: the core search flow never needs Laya.
# Start the classifier with scripts/laya-serve.sh, then set LAYA_ENABLED=true and restart Rails.
# Only the literal values true, 1, yes, or on enable it; anything else (including typos) leaves it off.
LAYA_ENABLED=false
LAYA_URL=http://127.0.0.1:8765
# LAYA_API_KEY=replace_me
LAYA_MODEL=multilingual
LAYA_TIMEOUT_SECONDS=4
# Below this probability no plan is proposed. Measured on the dev split, see docs/intent-eval.md.
LAYA_MIN_CONFIDENCE=0.7
# Recorded with each plan for the audit trail (laya version and checkpoint commit in use).
# LAYA_VERSION_LABEL=0.4.15@7b928d8
# The sentences users type are deleted after this many days.
INTENT_RETENTION_DAYS=30

# Request budget and cache (Stage 4). SEARCH_MAX_REQUESTS_PER_DAY counts real SerpApi calls, retries included.
# SEARCH_CACHE_TTL_SECONDS=0 disables the local cache. Read the real quota from the SerpApi account, do not assume it.
SEARCH_MAX_REQUESTS_PER_DAY=5
SEARCH_CACHE_TTL_SECONDS=3600

# Maximum searches talking to SerpApi at the same time, across all workers (default 2).
SEARCH_MAX_CONCURRENCY=2

# Maximum number of tracked keywords. Bounds scheduled API usage (default 50).
SEARCH_MAX_KEYWORDS=50

# Development and test use the local PostgreSQL via config/database.yml (a Unix socket).
# Set DATABASE_URL only to override (it takes precedence over database.yml).
# On macOS leave the host out (postgresql:///searchops_development): with a host such as
# "localhost" the connection is TCP, and the Solid Queue worker that Puma forks can crash
# with "+[__NSCFConstantString initialize] ... fork()" (Objective-C fork safety).
# DATABASE_URL=postgresql:///searchops_development

# Production database password (Stage 8)
# SEARCHOPS_DATABASE_PASSWORD=replace_me

# Job processing. SOLID_QUEUE_IN_PUMA is read before this file is loaded, so set it in the shell
# (default: on in development, off elsewhere), for example: SOLID_QUEUE_IN_PUMA=false bin/rails server
